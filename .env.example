# ── LLM provider ──────────────────────────────────────────────────────────────
# Choose "openai" (default) or "anthropic"
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ── Memory / checkpointer ──────────────────────────────────────────────────────
# Leave empty to use in-memory MemorySaver (ephemeral).
# Set a file path to persist memory with SqliteSaver.
SQLITE_DB_PATH=./memory/agent_memory.db

# ── API ────────────────────────────────────────────────────────────────────────
# Host and port for the FastAPI server (used by uvicorn in main.py)
HOST=0.0.0.0
PORT=8000
